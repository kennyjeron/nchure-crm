# Server-only secrets. Never commit a real .env file.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INITIAL_ADMIN_EMAIL=founder@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters
INITIAL_ADMIN_NAME=NCHURE Founder
# Leave blank for same-origin frontend/API deployment; otherwise list exact origins separated by commas.
CORS_ORIGINS=
